from fastapi import FastAPI, UploadFile, File
import torch
import torchvision.transforms as T
from PIL import Image
import io

app = FastAPI()

# 1. Load Meta's State-of-the-Art DINOv2 Giant Model
print("Loading Meta DINOv2 Giant Model (This may take a minute to download)...")
# We use torch hub to pull the latest DINOv2 model directly from Meta's research repo
model = torch.hub.load('facebookresearch/dinov2', 'dinov2_vitg14')
model.eval() # Set to inference mode

# Move to GPU if available (JarvisLabs has CUDA)
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
model.to(device)
print(f"Model loaded successfully on {device}!")

# 2. Define the High-Resolution Transformer Preprocessing
# DINOv2 works best at 518x518 resolution, which captures massive amounts of microscopic detail
preprocess = T.Compose([
    T.Resize(518, interpolation=T.InterpolationMode.BICUBIC),
    T.CenterCrop(518),
    T.ToTensor(),
    T.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)),
])

@app.post("/extract-features")
async def extract_features(file: UploadFile = File(...)):
    try:
        # Read the image uploaded by the backend
        image_bytes = await file.read()
        image = Image.open(io.BytesIO(image_bytes)).convert("RGB")
        
        # Preprocess into a high-res tensor and move to GPU
        input_tensor = preprocess(image).unsqueeze(0).to(device)
        
        # 3. Extract the microscopic structural features
        with torch.no_grad():
            # DINOv2 outputs a massive highly-detailed 1536-dimensional semantic vector
            features = model(input_tensor)
            
        # Convert back to a standard python list to send to the Windows backend
        embedding_list = features.squeeze().cpu().numpy().tolist()
        
        return {"embedding": embedding_list}
        
    except Exception as e:
        return {"error": str(e)}
        
